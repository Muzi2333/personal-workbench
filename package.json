{
  "name": "workbench",
  "productName": "工作台",
  "version": "0.2.3",
  "private": true,
  "description": "个人工作台 - 图标宫格快捷启动",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.muzi.workbench",
    "productName": "工作台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "rest.js",
      "renderer/**/*",
      "assets/**/*",
      "tools/icon-extract.ps1",
      "tools/icon-shell.ps1",
      "tools/lnk-target.ps1",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "工作台",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "pinyin-pro": "^3.29.5"
  }
}
